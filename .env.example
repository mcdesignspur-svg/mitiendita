# --- Sesiones (firmado de cookies). Cambia esto en producción. ---
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Admin (panel de operación interno) ---
ADMIN_PASSWORD="admin"

# --- Candado del sitio público (proxy.ts) ---
# El sitio principal está CERRADO por defecto: solo /exclusivo/* (links cerrados),
# /admin (login propio) y los webhooks quedan públicos. Se desbloquea con la misma
# ADMIN_PASSWORD en /entrar. Para REABRIR el sitio al público sin deploy, pon:
#   SITE_LOCK=off
# (déjalo sin definir, o cualquier valor distinto de "off", para mantenerlo cerrado)
# SITE_LOCK="off"

# --- AI (motor del sistema AI-first). Vercel AI Gateway. ---
# Con esta key se activan: autocompletar producto, agente de sourcing,
# copiloto de verificación B2B, asistente de compras y copy de marketing.
# Sin la key todo funciona igual con resultados deterministas (plantilla/heurística).
AI_GATEWAY_API_KEY=""
# Modelo por defecto (opcional). Cualquier string "proveedor/modelo" del gateway.
AI_MODEL="anthropic/claude-sonnet-4-6"

# --- Email transaccional (opcional, Resend) ---
# Con esta key se envían confirmaciones de pedido y avisos de verificación.
# Sin ella, las notificaciones se registran en consola y la app no falla.
RESEND_API_KEY=""
EMAIL_FROM="Mi Tiendita PR <onboarding@resend.dev>"

# --- Alibaba.com Open Platform (ICBU) — sourcing real (opcional) ---
# Crea una app en la consola del Open Platform → App Key + App Secret.
# Sin estas llaves, el operador cae a su método de búsqueda actual.
ALIBABA_APP_KEY=""
ALIBABA_APP_SECRET=""
# access_token: se obtiene tras autorizar la app (OAuth → /auth/token/create).
ALIBABA_ACCESS_TOKEN=""
# Opcionales (ajusta si tu consola muestra otros paths/gateway):
# ALIBABA_GATEWAY="https://openapi-api.alibaba.com/rest"
# ALIBABA_PRODUCT_SEARCH_PATH="/icbu/product/search"
# ALIBABA_PRODUCT_GET_PATH="/icbu/product/get"

# --- Bus del operador (opcional, pero requerido para los endpoints) ---
# Token secreto para el bus: POST /api/operator/ingest, GET /api/operator/brief,
# POST /api/operator/queue/<id>/done. Cualquier agente (el Claude de Chrome, un
# cron, etc.) lo manda como  Authorization: Bearer <token>.
# Genera uno fuerte:  openssl rand -hex 32   · sin token, el bus está apagado (503).
OPERATOR_INGEST_TOKEN=""

# --- Cron diario del operador (opcional) ---
# Vercel agrega  Authorization: Bearer <CRON_SECRET>  a GET /api/cron/daily.
# Sin esta variable, el endpoint se permite (útil para probarlo a mano en dev).
CRON_SECRET=""

# --- Imágenes de productos (Vercel Blob) ---
# Crea un Blob store en Vercel → Storage. Sin esto, la subida de imágenes falla
# (pero el resto de la app funciona con emoji/fondo de respaldo).
BLOB_READ_WRITE_TOKEN=""

# --- Base de datos (Postgres/Neon) ---
# Si está presente, la app usa Postgres. Si falta, usa el archivo local /.data.
# Pega aquí la connection string de Neon (incluye ?sslmode=require).
DATABASE_URL=""
# Conexión directa/unpooled (requerida por drizzle.config.ts para DDL / db:push).
# En Neon: la misma URL pero con el prefijo de conexión directa (sin pooling).
DATABASE_URL_UNPOOLED=""

# --- Pagos con Stripe (opcional) ---
# Activa el flujo de cobro con Stripe (checkout + webhooks).
# Sin estas vars, el botón de pago con tarjeta no aparece.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Pagos con ATH Móvil (opcional) ---
# Activa el botón de ATH Móvil en el checkout.
# NEXT_PUBLIC_* se expone al browser; ATHM_PRIVATE_TOKEN y ATH_WEBHOOK_BASE son server-only.
NEXT_PUBLIC_ATHM_PUBLIC_TOKEN=""
NEXT_PUBLIC_ATHM_PHONE=""
ATHM_PRIVATE_TOKEN=""
# URL base para los webhooks de confirmación de ATH Móvil (ej: https://mitienditapr.net).
ATH_WEBHOOK_BASE=""

# --- Sesiones (firmado de cookies). Cambia esto en producción. ---
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Admin (panel de operación interno) ---
ADMIN_PASSWORD="admin"

# --- AI (motor del sistema AI-first). Vercel AI Gateway. ---
# Con esta key se activan: autocompletar producto, agente de sourcing,
# copiloto de verificación B2B, asistente de compras y copy de marketing.
# Sin la key todo funciona igual con resultados deterministas (plantilla/heurística).
AI_GATEWAY_API_KEY=""
# Modelo por defecto (opcional). Cualquier string "proveedor/modelo" del gateway.
AI_MODEL="anthropic/claude-sonnet-4-6"

# --- Email transaccional (opcional, Resend) ---
# Con esta key se envían confirmaciones de pedido y avisos de verificación.
# Sin ella, las notificaciones se registran en consola y la app no falla.
RESEND_API_KEY=""
EMAIL_FROM="Mi Tiendita PR <onboarding@resend.dev>"

# --- Imágenes de productos (Vercel Blob) ---
# Crea un Blob store en Vercel → Storage. Sin esto, la subida de imágenes falla
# (pero el resto de la app funciona con emoji/fondo de respaldo).
BLOB_READ_WRITE_TOKEN=""

# --- Base de datos (Postgres/Neon) ---
# Si está presente, la app usa Postgres. Si falta, usa el archivo local /.data.
# Pega aquí la connection string de Neon (incluye ?sslmode=require).
DATABASE_URL=""
